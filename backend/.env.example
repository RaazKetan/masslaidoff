PORT=8080
# Anything other than "development" requires RESEND_API_KEY, FRONTEND_URL and SUPABASE_SECRET_KEY.
ENVIRONMENT=development
# Proxies in front of the API that append X-Forwarded-For (Cloud Run: 1). 0 = use the TCP peer.
TRUSTED_PROXY_HOPS=0
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_POOLER_REGION=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=sb_secret_your-server-key
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGINS=http://127.0.0.1:4175,https://masslaidoff.vercel.app
FRONTEND_URL=http://127.0.0.1:4175
RESEND_API_KEY=
EMAIL_FROM=MassLaidOff <verify@masslaidoff.com>
# Dev-only (ENVIRONMENT=development): comma-separated personal addresses accepted as company emails for testing.
TEST_COMPANY_EMAILS=
